# Copie para .env e preencha o que for usar.

# Chave gratuita do Portal da Transparencia (CGU), necessaria apenas para
# coletar emendas parlamentares:
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
CHAVE_PORTAL_TRANSPARENCIA=

# Onde o armazem Parquet fica. Padrao: ./dados
# PAINEL_DADOS=D:\dados-painel

# API local
PAINEL_API_HOST=127.0.0.1
PAINEL_API_PORTA=8000

# Parquet
PAINEL_COMPRESSAO=zstd
PAINEL_NIVEL_COMPRESSAO=3
PAINEL_ROW_GROUP=122880

# Rede
PAINEL_TENTATIVAS=4
PAINEL_TEMPO_LIMITE=60
